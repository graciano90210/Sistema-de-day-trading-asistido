# Copia este archivo a .env y rellena tus keys de la cuenta PAPER de Alpaca.
# https://app.alpaca.markets/paper/dashboard/overview  -> API Keys
# .env está en .gitignore: nunca lo subas.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# No existe opción para trading real: el sistema usa siempre https://paper-api.alpaca.markets

# SEC EDGAR exige un contacto en el User-Agent: "NombreApp tu@email.com" (solo se envía a sec.gov)
SEC_USER_AGENT=
